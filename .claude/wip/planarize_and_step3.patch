+/// Split queued edges where another queued edge ends on them. Spans queued by
+/// different face pairs can overlap without sharing vertices: a coplanar
+/// cavity floor imprints its outline on a cutter face, then a wall crossing
+/// the same cutter face queues one long line over that outline's edge. The
+/// partition graph needs every junction as a vertex; once split, the
+/// duplicated stretch is removed by [`deduplicate_splitting_edges`].
+fn planarize_splitting_edges(builder: &mut BRepBuilder, edges: &mut Vec<EdgeId>, tolerance: f64) {
+    const MAX_SPLITS: usize = 256;
+    for _ in 0..MAX_SPLITS {
+        let endpoints: Vec<(openrcad_topo::arena::VertexId, Pnt)> = edges
+            .iter()
+            .filter_map(|&edge| builder.brep().edges.get(edge))
+            .flat_map(|data| [data.start, data.end])
+            .map(|vertex| (vertex, builder.brep().vertices[vertex].point))
+            .collect();
+        let split = edges.iter().enumerate().find_map(|(index, &edge)| {
+            let data = builder.brep().edges.get(edge)?;
+            let curve = data.curve.as_ref()?;
+            let (start, end) = (
+                builder.brep().vertices[data.start].point,
+                builder.brep().vertices[data.end].point,
+            );
+            endpoints.iter().find_map(|&(vertex, point)| {
+                if vertex == data.start
+                    || vertex == data.end
+                    || point.distance(&start) <= tolerance
+                    || point.distance(&end) <= tolerance
+                {
+                    return None;
+                }
+                let (low, high) = (data.first.min(data.last), data.first.max(data.last));
+                let t = project_point_on_curve(&point, curve, low, high);
+                (curve.point(t).distance(&point) <= tolerance && t > low && t < high)
+                    .then_some((index, edge, vertex, t))
+            })
+        });
+        let Some((index, edge, vertex, t)) = split else {
+            return;
+        };
+        let (first, second) = builder.split_edge(edge, vertex, t);
+        edges.remove(index);
+        edges.push(first);
+        edges.push(second);
+    }
+}
